  "options": {
    "pageEditMode": "standard",
    "showSurveyHeader": false,
    "showHeaderInEmptySurvey": false,
    "useElementTitles": false,
    "allowDragPages": true,
    "allowZoom": true,
    "expandCollapseButtonVisibility": "always",
    "collapseQuestions": false,
    "collapsePanels": false,
    "collapsePages": false,
    "maxRows": 0,
    "maxColumns": 0,
    "minChoices": 0,
    "maxChoices": 0,
    "maxVisibleChoices": 10,
    "maxChoiceContentNestingLevel": 0,
    "maxRateValues": 0,
    "maxPanelNestingLevel": -1,
    "expressionsValidateFunctions": true,
    "expressionsValidateVariables": false,
    "expressionsValidateSyntax": true,
    "previewAllowSimulateDevices": true,
    "previewDevice": "androidPhone",
    "previewOrientation": "portrait",
    "previewAllowSelectLanguage": "auto",
    "previewAllowSelectPage": true,
    "previewAllowHiddenElements": true,
    "logicAllowTextEditExpressions": false,
    "logicMaxItemsInCondition": -1,
