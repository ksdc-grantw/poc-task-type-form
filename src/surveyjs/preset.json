  "toolbox": {
    "definition": [
      {
        "name": "text",
        "subitems": []
      },
      {
        "name": "comment"
      },
      {
        "name": "checkbox"
      },
      {
        "name": "radiogroup"
      },
      {
        "name": "dropdown"
      },
      {
        "name": "boolean"
      },
      {
        "name": "rating",
        "subitems": [],
        "json": {
          "type": "rating",
          "rateType": "labels"
        }
      },
      {
        "name": "number",
        "title": "Number",
        "json": {
          "type": "text",
          "inputType": "number"
        },
        "iconName": "icon-toolbox-number-24x24"
      },
      {
        "name": "photo",
        "title": "Photo",
        "iconName": "icon-toolbox-image-24x24",
        "json": {
          "type": "file",
          "photoOnly": true,
          "acceptedCategories": [
            "image"
          ],
          "sourceType": "file-camera",
          "maxFiles": 5
        }
      },
      {
        "name": "merchsurvey",
        "title": "Merchandising Survey",
        "iconName": "icon-toolbox-merchsurvey-24x24",
        "json": {
          "type": "matrixdropdown",
          "title": "Merchandising Survey",
          "merchSurvey": true,
          "alternateRows": true,
          "columns": [
            { "name": "ShelfFacings", "title": "How many shelf facings?", "cellType": "text", "inputType": "number" },
            {
              "name": "ProductPlacement",
              "title": "Which shelf is the product on?",
              "cellType": "dropdown",
              "choices": [
                { "value": 1, "text": "Top" },
                { "value": 2, "text": "Middle" },
                { "value": 3, "text": "Bottom" },
                { "value": 4, "text": "No stock" }
              ],
              "storeOthersAsComment": true
            },
            {
              "name": "2ndDisplayType",
              "title": "If there is another display in store, what type of display is it?",
              "cellType": "dropdown",
              "choices": [
                { "value": 1, "text": "Gondola End" },
                { "value": 2, "text": "Free Standing Unit" },
                { "value": 3, "text": "Shelf Display" }
              ],
              "storeOthersAsComment": true
            }
          ],
          "rows": []
        }
      },
      {
        "name": "dynamicmerchsurvey",
        "title": "Dynamic Merchandising Survey",
        "iconName": "icon-toolbox-dynamicmerchsurvey-24x24",
        "json": {
          "type": "matrixdynamic",
          "title": "Dynamic Merchandising Survey",
          "merchSurvey": true,
          "alternateRows": true,
          "rowCount": 1,
          "minRowCount": 1,
          "addRowText": "Add product",
          "keyName": "Product",
          "columns": [
            { "name": "Product", "title": "Product", "cellType": "dropdown", "isRequired": true, "choices": [] },
            { "name": "ShelfFacings", "title": "How many shelf facings?", "cellType": "text", "inputType": "number" },
            {
              "name": "ProductPlacement",
              "title": "Which shelf is the product on?",
              "cellType": "dropdown",
              "choices": [
                { "value": 1, "text": "Top" },
                { "value": 2, "text": "Middle" },
                { "value": 3, "text": "Bottom" },
                { "value": 4, "text": "No stock" }
              ],
              "storeOthersAsComment": true
            },
            {
              "name": "2ndDisplayType",
              "title": "If there is another display in store, what type of display is it?",
              "cellType": "dropdown",
              "choices": [
                { "value": 1, "text": "Gondola End" },
                { "value": 2, "text": "Free Standing Unit" },
                { "value": 3, "text": "Shelf Display" }
              ],
              "storeOthersAsComment": true
            }
          ]
        }
      },
      {
        "name": "shopperquestionnaire",
        "title": "Shopper Questionnaire",
        "iconName": "icon-toolbox-shopperquestionnaire-24x24",
        "json": {
          "type": "paneldynamic",
          "title": "Shopper Questionnaire",
          "shopperQuestionnaire": true,
          "templateTitle": "{panel.product}",
          "panelCount": 1,
          "minPanelCount": 1,
          "addPanelText": "Add product",
          "templateElements": [
            { "type": "dropdown", "name": "product", "title": "Product", "isRequired": true, "choices": [] },
            {
              "type": "rating",
              "name": "liking",
              "title": "How much did you like this product?",
              "rateMin": 1,
              "rateMax": 5,
              "minRateDescription": "Disliked it a lot",
              "maxRateDescription": "Liked it a lot"
            },
            {
              "type": "dropdown",
              "name": "likeMost",
              "title": "What do you like the MOST about this product?",
              "choices": ["The Smell", "The Chilli Taste", "The Saltiness", "The Colour"],
              "showOtherItem": true
            },
            {
              "type": "dropdown",
              "name": "likeLeast",
              "title": "What do you like the LEAST about this product?",
              "choices": ["The Smell", "The Chilli Taste", "The Saltiness", "The Colour"],
              "showOtherItem": true
            },
            {
              "type": "rating",
              "name": "texture",
              "title": "How would you rate the texture of this product?",
              "rateMin": 1,
              "rateMax": 5,
              "minRateDescription": "Very soft",
              "maxRateDescription": "Very hard"
            },
            { "type": "text", "name": "textureDislike", "title": "What do you like the least about the texture of this product?" },
            {
              "type": "dropdown",
              "name": "serving",
              "title": "How are you serving this product?",
              "choices": ["With rice", "With pap", "With paste", "With samp", "As a thickener"],
              "showOtherItem": true
            },
            {
              "type": "rating",
              "name": "recommend",
              "title": "How likely are you to recommend this product to a friend?",
              "rateMin": 1,
              "rateMax": 10,
              "minRateDescription": "Very unlikely",
              "maxRateDescription": "Very likely"
            }
          ]
        }
      },
      {
        "name": "phototag",
        "title": "Take Photo",
        "iconName": "icon-toolbox-phototag-24x24",
        "json": {
          "type": "panel",
          "title": "Take Photo",
          "photoTag": true,
          "elements": [
            {
              "type": "file",
              "name": "photo",
              "title": "Photo",
              "photoOnly": true,
              "acceptedCategories": ["image"],
              "sourceType": "file-camera",
              "allowMultiple": true,
              "maxFiles": 5
            },
            {
              "type": "checkbox",
              "name": "tags",
              "title": "Tags",
              "choices": [
                { "value": "sf", "text": "Good shelf space" },
                { "value": "item2", "text": "Bad shelf space" },
                { "value": "item3", "text": "No stock" },
                { "value": "item4", "text": "Not ranged in store" },
                { "value": "item5", "text": "Category not sold in store" },
                { "value": "item6", "text": "Promotion – own product" },
                { "value": "item7", "text": "Promotion – competitor product" },
                { "value": "item8", "text": "New product – own product" },
                { "value": "item9", "text": "New product – competitor product" }
              ]
            }
          ]
        }
      }
    ],
    "categories": [
      {
        "category": "general",
        "items": [
          "text",
          "number",
          "comment",
          "checkbox",
          "radiogroup",
          "dropdown",
          "boolean",
          "rating",
          "photo"
        ]
      },
      {
        "category": "custom",
        "items": [
          "merchsurvey",
          "dynamicmerchsurvey",
          "shopperquestionnaire",
          "phototag"
        ]
      }
    ]
  },
  "propertyGrid": {
